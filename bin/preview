#!/bin/sh
# Takes a UI preview: screenshots of this workspace's own pages, taken before
# they are deployed (specs/ui-preview.md, PREVIEW-1).
#
#   bin/preview                      # the empty state and the sample chat
#   bin/preview @chat                # just the sample chat
#   bin/preview @ask                 # the chat whose turn is paused on a question
#   bin/preview / /files /settings   # pages of your choosing
#   ELIA_PREVIEW_WIDTH=390 bin/preview @chat   # the small-screen layout
#   ELIA_PREVIEW_THEME=dark bin/preview @chat  # the dark theme
#
# It prints a Markdown image link per picture, which is what shows a screenshot
# in the chat. The pictures go to tmp/preview/ (gitignored).
#
# Environment:
#   ELIA_PREVIEW_PORT    port the preview server listens on (default 4010)
#   ELIA_PREVIEW_WIDTH   viewport width  (default 1280)
#   ELIA_PREVIEW_HEIGHT  viewport height (default 900)
#   ELIA_PREVIEW_WAIT    milliseconds to settle after a page loads (default 500)
#   ELIA_PREVIEW_THEME   colour scheme to emulate: dark or light

cd "$(dirname "$0")/.." || exit 1

# The browser layer's Node packages (PREVIEW-14, BROWSER-2): assets/node_modules
# is gitignored, so a fresh chat worktree has none, and the Playwright driver
# refuses to start without it. Install them once per worktree, skipping it when
# they are already there, so a preview never pays for this twice.
if [ ! -f assets/node_modules/playwright/package.json ]; then
  echo "preview: installing the browser layer's packages (npm install)"
  npm install --prefix assets --no-audit --no-fund || {
    echo "preview: npm install failed in $PWD/assets — run it yourself (Node >= 20, network)" >&2
    exit 1
  }
fi

# A preview must not show a stale bundle: build the assets the browser loads
# (PREVIEW-1, PREVIEW-6). Both steps are no-ops once they have been run. They
# run in the test env — the preview's own env — and a chat worktree's
# dependencies are compiled there on first use, in the worktree's own layer
# (ISOL-7), so this works inside the jail a command runs in.
MIX_ENV=test mix assets.setup || exit 1
MIX_ENV=test mix assets.build || exit 1

# Where the pictures go, and where the preview test writes them (PREVIEW-4).
ELIA_PREVIEW_DIR="$PWD/tmp/preview"
export ELIA_PREVIEW_DIR

# The test env server it drives (BROWSER-3), on its own port so it can't meet a
# chat that is running its tests at the same time (BROWSER-2, PREVIEW-1).
export ELIA_BROWSER_TESTS=1
ELIA_TEST_PORT=${ELIA_PREVIEW_PORT:-4010}
export ELIA_TEST_PORT

# The pages to preview, one per line (PREVIEW-11: `@chat` is the sample chat).
if [ "$#" -gt 0 ]; then
  PREVIEW_PATHS=$(printf '%s\n' "$@")
  export PREVIEW_PATHS
fi

exec env MIX_ENV=test mix test --only preview
