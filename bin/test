#!/bin/sh
# Runs the test suite in parallel partitions (specs/test-suite.md).
#
#   bin/test                     the whole suite, in partitions
#   bin/test --plan              print the split and the command, run nothing
#   bin/test test/foo_test.exs   one plain `mix test` with those arguments
#   bin/test --failed            likewise
#
# Environment:
#   ELIA_TEST_PARTITIONS  how many partitions to start (default 4)
#   ELIA_TEST_CMD         the command a partition runs (default: mix test)
#   ELIA_TEST_RETRY       1 (default) runs a failed partition once more, 0 does not
#
# Exit status is 0 only when every partition passed, a partition that failed and
# passed on the retry included.

cd "$(dirname "$0")/.." || exit 1

partitions=${ELIA_TEST_PARTITIONS:-4}
cmd=${ELIA_TEST_CMD:-"mix test"}
retry=${ELIA_TEST_RETRY:-1}

plan_only=0
if [ "$1" = "--plan" ]; then
  plan_only=1
  shift
fi

# A partition's own scratch state, under the run's own directory (SUITE-1,
# SUITE-11): `mktemp -d` makes that directory, every partition's state lives in a
# subdirectory of it, and the trap removes the whole thing when the run ends.
# TMPDIR matters as much as the rest: test paths are named with
# `System.unique_integer/1`, which is unique inside one BEAM node only, so two
# runs in a shared temp dir would otherwise pick the same live tree.
#
# Each names a path from the run's directory, so the plan passes the literal
# `<run>` and a real run passes the directory it made: the real one differs every
# run, and a plan that printed it would differ too (SUITE-3, SUITE-4).
run_of() { echo "$1/p$2"; }
tmpdir_of() { echo "$(run_of "$1" "$2")/tmp"; }
workspace_of() { echo "$(run_of "$1" "$2")/workspace"; }
settings_of() { echo "$(run_of "$1" "$2")/settings/settings.dets"; }
port_of() { echo $((4002 + $1 - 1)); }
# A retry gets a port of its own, clear of every first-pass partition's
# (SUITE-14).
retry_port_of() { echo $((4002 + partitions + $1 - 1)); }

# How slow a file is, in rough milliseconds of a partition's own wall time: a
# file's own ExUnit time, from `mix test <file>` run alone on a 4-core machine
# on 2026-11-25 (the `Finished in …` of that run), so the numbers are what a
# file costs rather than a guess from an older tree. A file not listed gets the
# default below, so a new file still gets a home without anyone updating this
# table (SUITE-3).
weight_of() {
  case "$1" in
    test/elia/agent_test.exs) echo 10800 ;;
    test/elia/auto_approve_test.exs) echo 800 ;;
    test/elia/command_isolation_test.exs) echo 2000 ;;
    test/elia/deployment_test.exs) echo 44600 ;;
    test/elia/llm/compaction_test.exs) echo 800 ;;
    test/elia/llm/llama_server_test.exs) echo 7900 ;;
    test/elia/llm/stream_timeout_test.exs) echo 3400 ;;
    test/elia/net_proxy_test.exs) echo 3000 ;;
    test/elia/network_access_test.exs) echo 6800 ;;
    test/elia/push_notifier_test.exs) echo 900 ;;
    test/elia/self_modification_test.exs) echo 6800 ;;
    test/elia/serve_script_test.exs) echo 5300 ;;
    test/elia/shell_test.exs) echo 2700 ;;
    test/elia/skills/shell_test.exs) echo 2200 ;;
    test/elia/skills/terminal_test.exs) echo 2600 ;;
    test/elia/snapshot_test.exs) echo 1400 ;;
    test/elia/step_timing_test.exs) echo 700 ;;
    test/elia/tasks_test.exs) echo 2300 ;;
    test/elia/terminal_test.exs) echo 5100 ;;
    test/elia/test_script_test.exs) echo 2800 ;;
    test/elia_web/live/active_chats_test.exs) echo 700 ;;
    test/elia_web/live/auto_approve_test.exs) echo 800 ;;
    test/elia_web/live/chat_drawer_test.exs) echo 700 ;;
    test/elia_web/live/chat_list_test.exs) echo 1300 ;;
    test/elia_web/live/chat_live_test.exs) echo 5500 ;;
    test/elia_web/live/chat_settings_test.exs) echo 900 ;;
    test/elia_web/live/chat_upload_test.exs) echo 2000 ;;
    test/elia_web/live/compaction_test.exs) echo 800 ;;
    test/elia_web/live/compact_view_test.exs) echo 700 ;;
    test/elia_web/live/dashboard_test.exs) echo 2200 ;;
    test/elia_web/live/files_live_test.exs) echo 1600 ;;
    test/elia_web/live/project_switcher_test.exs) echo 800 ;;
    test/elia_web/live/settings_live_test.exs) echo 26300 ;;
    test/elia_web/live/task_ui_test.exs) echo 900 ;;
    test/elia_web/live/terminal_live_test.exs) echo 700 ;;
    test/elia_web/recovery_test.exs) echo 2000 ;;
    test/elia_web/terminal_channel_test.exs) echo 2800 ;;
    # What a file not listed above costs, in the same units: the rest of the
    # suite averages about 190 ms a file, so they spread out instead of all
    # landing on whichever partition the heavy files left lightest.
    *) echo 190 ;;
  esac
}

# The split: the heaviest file goes first, each one to the lightest partition so
# far, ties to the lowest number, so the same files always split the same way
# (SUITE-3). Prints "<partition> <weight> <files...>" per partition.
split() {
  find test -name '*_test.exs' | sort | while read -r file; do
    printf '%s %s\n' "$(weight_of "$file")" "$file"
  done | sort -k1,1nr -k2,2 | awk -v n="$partitions" '
    {
      best = 1
      for (p = 2; p <= n; p++) if (loads[p] < loads[best]) best = p
      loads[best] += $1
      files[best] = (files[best] == "" ? $2 : files[best] " " $2)
    }
    END { for (p = 1; p <= n; p++) printf "%d %d %s\n", p, loads[p], files[p] }'
}

if [ "$plan_only" = 1 ]; then
  if [ $# -gt 0 ]; then
    echo "single run: $cmd $*"
  else
    echo "run: <run> — one \`mktemp -d\` directory per run, removed when it ends (SUITE-11)"
    if [ "$retry" = 1 ]; then
      echo "retry: on — a partition that failed is run once more (SUITE-14)"
    else
      echo "retry: off — ELIA_TEST_RETRY=0"
    fi
    plan_root="<run>"
    split | while read -r p weight files; do
      echo "partition $p (weight $weight)"
      echo "  files: $files"
      echo "  env: ELIA_TEST_RUN=$(run_of "$plan_root" "$p") TMPDIR=$(tmpdir_of "$plan_root" "$p") ELIA_TEST_WORKSPACE=$(workspace_of "$plan_root" "$p") ELIA_TEST_SETTINGS=$(settings_of "$plan_root" "$p") ELIA_TEST_PORT=$(port_of "$p")"
      echo "  command: $cmd --no-compile $files"
    done
  fi
  exit 0
fi

# Arguments make it a single plain run: a file, --failed, --only (SUITE-6).
if [ $# -gt 0 ]; then
  exec $cmd "$@"
fi

case "$partitions" in
  '' | *[!0-9]*) echo "bin/test: ELIA_TEST_PARTITIONS must be a number" >&2; exit 2 ;;
esac
if [ "$partitions" -lt 1 ]; then
  echo "bin/test: ELIA_TEST_PARTITIONS must be at least 1" >&2
  exit 2
fi
case "$retry" in
  0 | 1) ;;
  *) echo "bin/test: ELIA_TEST_RETRY must be 0 or 1" >&2; exit 2 ;;
esac

tmp=$(mktemp -d "${TMPDIR:-/tmp}/elia-test-run-XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM

start=$(date +%s)

# Compile once, here: the partitions run with compilation skipped, so none of
# them builds the same tree at the same time (SUITE-2). A substituted
# ELIA_TEST_CMD is not `mix test`, so it gets no compile of its own.
if [ -z "$ELIA_TEST_CMD" ]; then
  MIX_ENV=test mix compile --quiet || exit 1
fi

split > "$tmp/plan"

# One attempt at one partition (SUITE-2): its own state and its own port under
# the run's directory (SUITE-1, SUITE-11), its log beside them, and the seconds
# it ran written there as it exits — so a partition's printed time is its own and
# not the moment the waiting loop reached it (SUITE-15).
# $1 the partition, $2 its files, $3 the attempt's suffix (`3` or `3-retry`,
# which names its directory, log and time), $4 its port. Sets `launch_pid`: the
# attempt has to be started by this shell, not by a command substitution, or
# `wait` could not wait for it.
launch() {
  suffix=$3
  (
    # SUITE-1, SUITE-11: the partition's own state, under the run's directory,
    # which the trap above removes with the logs when the run ends.
    ELIA_TEST_RUN=$(run_of "$tmp" "$suffix")
    TMPDIR=$(tmpdir_of "$tmp" "$suffix")
    ELIA_TEST_WORKSPACE=$(workspace_of "$tmp" "$suffix")
    ELIA_TEST_SETTINGS=$(settings_of "$tmp" "$suffix")
    ELIA_TEST_PORT=$4
    export ELIA_TEST_RUN TMPDIR ELIA_TEST_WORKSPACE ELIA_TEST_SETTINGS ELIA_TEST_PORT
    mkdir -p "$TMPDIR"
    began=$(date +%s)
    $cmd --no-compile $2
    attempt_status=$?
    echo "$(($(date +%s) - began))" > "$tmp/p$suffix.time"
    exit $attempt_status
  ) > "$tmp/p$suffix.log" 2>&1 &
  launch_pid=$!
}

# A partition's ExUnit summary line, for the one-line report (SUITE-7).
summary() {
  line=$(grep -E 'tests?, [0-9]+ failures?' "$1" | tail -n 1)
  if [ -z "$line" ]; then line="(no summary)"; fi
  echo "$line"
}

# The seconds the attempt with suffix $1 ran: the number it wrote as it exited,
# or `?` for an attempt that never got to write one (SUITE-15).
time_of() {
  if [ -f "$tmp/p$1.time" ]; then cat "$tmp/p$1.time"; else echo '?'; fi
}

# The first pass: every partition at once, its files kept for a retry (SUITE-2).
: > "$tmp/runs"
while read -r p weight files; do
  echo "$files" > "$tmp/p$p.files"
  launch "$p" "$files" "$p" "$(port_of "$p")"
  echo "$p $launch_pid $p" >> "$tmp/runs"
done < "$tmp/plan"

failed=""
while read -r p pid suffix; do
  if wait "$pid"; then
    printf 'partition %s: passed in %ss  %s\n' "$p" "$(time_of "$suffix")" "$(summary "$tmp/p$suffix.log")"
  else
    printf 'partition %s: FAILED in %ss\n' "$p" "$(time_of "$suffix")"
    failed="$failed $p"
  fi
done < "$tmp/runs"

# SUITE-14: after the first pass has been waited on, a partition that failed is
# run once more — its own files, its own fresh state, a directory and a port of
# its own, never the ones the first attempt used. SUITE-16: with the retry off
# the run stops after the first pass.
still_failed="$failed"
if [ "$retry" = 1 ] && [ -n "$failed" ]; then
  remaining=""
  for p in $failed; do
    suffix="$p-retry"
    launch "$p" "$(cat "$tmp/p$p.files")" "$suffix" "$(retry_port_of "$p")"
    if wait "$launch_pid"; then
      printf 'partition %s: FAILED, then passed on the retry in %ss  %s\n' \
        "$p" "$(time_of "$suffix")" "$(summary "$tmp/p$suffix.log")"
    else
      printf 'partition %s: FAILED again on the retry in %ss\n' "$p" "$(time_of "$suffix")"
      remaining="$remaining $p"
    fi
  done
  still_failed="$remaining"
fi

# A partition that failed shows its output (SUITE-5, SUITE-7): the retry's where
# there was one, the first attempt's where the retry was off.
for p in $still_failed; do
  if [ -f "$tmp/p$p-retry.log" ]; then log="$tmp/p$p-retry.log"; else log="$tmp/p$p.log"; fi
  echo "----- partition $p output -----"
  cat "$log"
  echo "----- end of partition $p -----"
done

printf 'total: %ss\n' "$(($(date +%s) - start))"

# SUITE-5: 0 only when every partition passed, a partition that failed and passed
# on the retry included.
if [ -n "$still_failed" ]; then exit 1; fi
exit 0
