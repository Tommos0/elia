<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <%!-- PWA-7: a phone's on-screen keyboard resizes the page instead of covering
    its bottom, where a chat's composer is (UI-78). A browser that doesn't know
    the directive ignores it. --%>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} crossorigin="use-credentials" />
    <meta name="theme-color" content="#111827" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <.live_title default="Elia" prefix="Elia - " phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- BUNDLE-2: the version of the bundle this document loaded, so the page
    can tell whether the server serves another one now and load itself again
    (BUNDLE-4, BUNDLE-5). --%>
    <meta name="elia-asset-version" content={AssetVersion.current()} />
    <%!-- PWA-8: the bundle is fetched under a version read from the built file,
    so a page that loads again on a new build does not get the old one from the
    browser's cache. --%>
    <link
      phx-track-static
      rel="stylesheet"
      href={AssetVersion.versioned(~p"/assets/css/app.css")}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={AssetVersion.versioned(~p"/assets/js/app.js")}
    >
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
    <%!-- CONF-30 - CONF-35: the UI scale is the browser's own preference, the way
    the theme is, and this is what applies it before anything is painted
    (CONF-33). The scale in force is on the root element as `data-ui-scale`, so
    the settings page's control (#ui-scale) reads it there, and asks for a new
    one by dispatching `phx:set-ui-scale` the same way the theme's buttons
    dispatch `phx:set-theme`. --%>
    <script>
      (() => {
        const KEY = "elia:ui-scale";
        const MIN = 80;
        const MAX = 150;

        // CONF-35: what cannot be read as a scale in range is 100%.
        const read = (value) => {
          const scale = parseInt(value, 10);
          return Number.isInteger(scale) && scale >= MIN && scale <= MAX ? scale : 100;
        };

        // CONF-31: rem is the root font size, so setting it scales the page.
        // CONF-32: the browser keeps the value, and nothing is sent anywhere.
        const setScale = (value) => {
          const scale = read(value);
          document.documentElement.style.fontSize = `${scale}%`;
          document.documentElement.dataset.uiScale = `${scale}`;
          try {
            localStorage.setItem(KEY, `${scale}`);
          } catch (_) {
            /* a browser that refuses storage still gets the scale for this page */
          }
        };

        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (_) {
          stored = null;
        }

        setScale(stored);
        window.addEventListener("storage", (e) => e.key === KEY && setScale(e.newValue));
        window.addEventListener("phx:set-ui-scale", (e) => setScale(e.target.dataset.phxUiScale));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
