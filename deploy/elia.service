# systemd user unit for Elia (specs/auto-restart.md, RESTART-8).
# Install with bin/install-service, which fills in the project root and PATH below.

[Unit]
Description=Elia (local AI harness)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PATH=@PATH@
# No MIX_ENV here (RESTART-8, ISOL-24): the server runs in Mix's default dev
# env either way, and a value would be inherited by every command it spawns.
# Optional: API keys, PORT, ... as KEY=value lines. The file may be missing.
EnvironmentFile=-%h/.config/elia/env
ExecStart=@ROOT@/bin/serve
# bin/serve restarts the server itself; this only covers bin/serve dying.
Restart=on-failure
RestartSec=5
# SIGTERM goes to bin/serve only, which stops the server cleanly.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
